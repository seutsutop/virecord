<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>VIrecord</AssemblyName>
    <RootNamespace>VIrecord</RootNamespace>
    <Version>1.0.0</Version>
    <Company>VIbrah</Company>
    <Product>VIrecord</Product>
    <Description>Screen recorder for Windows</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VIrecord.Core\VIrecord.Core.csproj" />
    <ProjectReference Include="..\VIrecord.Capture\VIrecord.Capture.csproj" />
    <ProjectReference Include="..\VIrecord.Encoding\VIrecord.Encoding.csproj" />
  </ItemGroup>
</Project>